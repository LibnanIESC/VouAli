<?xml version="1.0" encoding="utf-8"?>
<!-- O fundo e o logo sao camadas separadas de proposito: o Android recorta o
     icone com a mascara do fabricante (circulo, quadrado, gota) e so o miolo
     aparece garantido. O navy sangra ate a borda; o logo fica no miolo. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
