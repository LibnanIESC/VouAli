{
  "appId": "app.vouali",
  "appName": "VouAli",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#FBF4E9"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    },
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#FBF4E9",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK"
    }
  }
}
