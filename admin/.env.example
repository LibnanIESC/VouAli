# Senha do estágio 1. Sem ela o painel responde 503.
ADMIN_PASSWORD=

# Segredo DEDICADO que assina o cookie de sessão. Sem ele o painel responde 503.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=

# Mesmo Postgres do backend. No Railway, use referência de variável.
# Vazio = cai no SQLite local do backend (só para desenvolvimento).
DATABASE_URL=

# production liga Secure/__Host-/HSTS. Fora disso o login funciona em http://localhost.
ADMIN_ENV=development

# Nome exibido no app autenticador.
TOTP_ISSUER=VouAli Admin

# Bloqueio por IP.
RATE_LIMIT_MAX_FAILS=5
RATE_LIMIT_WINDOW_MIN=15
